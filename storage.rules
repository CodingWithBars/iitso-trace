rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to receipts/images
      allow read: if true;
      // Allow any authenticated user (admin/officer) to upload generally
      allow write: if request.auth != null;
    }
    
    // Allow public uploads for student avatars during registration
    match /student_avatars/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
